# EmailJS credentials
# Create a service and template in your EmailJS dashboard.
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PRIVATE_KEY=your_private_key
# Optional fallback if you prefer to use the public key instead of the private key
EMAILJS_PUBLIC_KEY=your_public_key

# Where enquiries should be delivered
CONTACT_TO_EMAIL=hello@lesoracreative.com
